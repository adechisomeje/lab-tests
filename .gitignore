# Source PDFs: 48MB, re-downloadable with `make fetch`, and redistributing the
# provider's original documents is the riskier licensing choice. The extracted
# text in raw/pdf-text/ IS tracked, so the build is reproducible without them.
raw/pdfs/

# Python
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/
*.egg-info/
dist/
build/

# Node
node_modules/
packages/typescript/dist/
# Copied from the canonical data/ at build time by `npm run sync-data`.
packages/typescript/data/

# OS
.DS_Store
