      "specimen": {
        "types": [
          "serum"
        ],
        "specimen_type_raw": "Clotted Blood/serum, paired sera",
        "container": "Clotted blood sample tube (no preservative)",
        "tube": {
          "type": "plain-serum",
          "cap_colour": "Red"
        },
        "minimum_volume_raw": "Minimum volume 0.6mL",
        "volume": {
          "value": 0.6,
          "unit": "mL"
        },
        "transport": "Ambient temperature via porter, courier, Royal Mail or DX compliant with IATA packing instruction 650",
        "special_precautions": "If the serum bactericidal activity is reported with the comment ‘SBA titre includes non- complement mediated lysis', then the result must be interpreted with caution. If in doubt, please telephone 0161 276 6791 for advice. If processing is delayed, refrigeration is preferable to storage at ambient temperature.\n\nDelays of over 48hr are undesirable."
      },
      "analysis": {
        "units": "SBA Titres expressed as the reciprocal of the final serum dilution giving ≥ 50% killing at 60 minutes calculated from the number of colony forming units (cfu) in the control",
        "clinical_decision_points": "For putative protection against serogroup B, the SBA titre must be ≥ 4 for at least 2 of the 3 strains used.",
        "interferences": "As this is a 'killing type' assay using live bacteria, antibiotics can impact on results. A control to monitor this is included in the assay.\n\nThe effect and impact of Eculizumab therapy on this assay is currently under investigation"
      },
      "turnaround": {
        "raw": "28 Working Days",
        "days": {
          "min": 28.0,
          "max": 28.0
        }
      },
      "result_format": {
        "kind": "single-analyte",
