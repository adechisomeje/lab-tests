      "id": "neisseria-meningitidis-functional-antibody-to-serogroup-b-by-serum-bactericidal",
      "name": "Neisseria meningitidis: Functional antibody to serogroup B by Serum Bactericidal Antibody Assay (SBA)",
      "aliases": [
        "Functional antibody to Neisseria meningitidis serogroup B by Serum Bactericidal Antibody Assay (SBA)"
      ],
      "description": "Serum Bactericidal Antibody Assay (SBA)",
      "department": "Vaccine Evaluation Unit",
      "letter": "N",
      "categories": [
        "autoimmunity",
        "infectious-disease-serology",
        "bacteriology"
      ],
      "clinic_profiles": [
