    {
      "id": "lipid-profile",
      "name": "Lipid Profile",
      "description": "Cardiovascular risk lipid panel.",
      "version": "0.1.0",
      "applies_to": [
        "lipid-profile-incl-total-cholesterol-ldl-hdl-triglyceride"
      ],
      "notice": "Starter templates. Confirm every component, unit and entry mode against your own laboratory's method before activating. Reference ranges and critical limits are intentionally not supplied.",
      "components": [
        {
          "id": "total-cholesterol",
          "name": "Total cholesterol",
          "type": "numeric",
          "entry_mode": "measured",
          "required": true,
          "suggested_units": "mmol/L",
          "alternate_units": [
            "mg/dL"
          ],
          "units_provenance": {
            "source": "mft-biochemistry-reference-ranges",
            "analyte": "Total Cholesterol"
          },
          "catalogue_ref": "cholesterol"
        },
        {
          "id": "hdl-cholesterol",
          "name": "HDL cholesterol",
          "type": "numeric",
          "entry_mode": "measured",
          "required": true,
          "suggested_units": "mmol/L",
          "alternate_units": [
            "mg/dL"
          ],
          "units_provenance": {
            "source": "mft-biochemistry-reference-ranges",
            "analyte": "HDL - blood"
          }
        },
        {
          "id": "ldl-cholesterol",
          "name": "LDL cholesterol",
          "type": "numeric",
          "entry_mode": "either",
          "required": true,
          "suggested_units": "mmol/L",
          "alternate_units": [
            "mg/dL"
          ],
          "units_provenance": {
            "source": "mft-biochemistry-reference-ranges",
            "analyte": "LDL"
          },
          "calculation": {
            "name": "Friedewald equation",
            "expression": "total_cholesterol - hdl_cholesterol - (triglycerides / 2.2)",
            "units_basis": "mmol/L",
            "caveats": "Not valid at high triglycerides (commonly cited limit ~4.5 mmol/L) or in non-fasting samples; many laboratories now measure LDL directly. Divisor differs in mg/dL-based systems.",
            "clinic_approval_required": true
          }
        },
        {
          "id": "triglycerides",
          "name": "Triglycerides",
          "type": "numeric",
          "entry_mode": "measured",
          "required": true,
          "suggested_units": "mmol/L",
          "alternate_units": [
            "mg/dL"
          ],
          "units_provenance": {
            "source": "mft-biochemistry-reference-ranges",
            "analyte": "Triglycerides"
          },
          "catalogue_ref": "triglycerides"
        },
        {
          "id": "non-hdl-cholesterol",
          "name": "Non-HDL cholesterol",
          "type": "numeric",
          "entry_mode": "calculated",
          "required": false,
          "suggested_units": "mmol/L",
          "units_provenance": {
            "source": "mft-biochemistry-reference-ranges",
            "analyte": "NON HDL Cholesterol (calculation)"
          },
          "calculation": {
            "name": "Non-HDL cholesterol",
            "expression": "total_cholesterol - hdl_cholesterol",
            "units_basis": "mmol/L",
            "clinic_approval_required": true
          }
        },
        {
          "id": "cholesterol-hdl-ratio",
          "name": "Cholesterol / HDL ratio",
          "type": "numeric",
          "entry_mode": "calculated",
          "required": false,
          "unitless": true,
          "calculation": {
            "name": "Cholesterol to HDL ratio",
            "expression": "total_cholesterol / hdl_cholesterol",
            "clinic_approval_required": true
          }
        }
      ],
