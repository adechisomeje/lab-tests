{
  "$comment": "Language-neutral conformance vectors. Every port of this library MUST pass all of them. Expected values are derived from the published source data, not from any one implementation, so a port cannot be 'correct' merely by matching another port's bug. Error codes are neutral names that each port maps to its own error type.",
  "version": "1.0.0",
  "dataset_version": "0.1.0",
  "error_codes": [
    "no_range_source",
    "unknown_test",
    "no_intervals",
    "no_applicable_stratum",
    "unknown_profile",
    "unknown_provider"
  ],
  "fold": [
    {
      "in": "Ferritin",
      "out": "ferritin"
    },
    {
      "in": "  Ferritin  ",
      "out": "ferritin"
    },
    {
      "in": "Anti-Müllerian",
      "out": "anti-mullerian"
    },
    {
      "in": "Naïve Memory",
      "out": "naive memory"
    },
    {
      "in": "ß2 Microglobulin",
      "out": "beta2 microglobulin"
    },
    {
      "in": "CSF – Protein",
      "out": "csf - protein"
    },
    {
      "in": "Farmer’s lung",
      "out": "farmer's lung"
    },
    {
      "in": "Cold agglutinin (4°C)",
      "out": "cold agglutinin (4c)"
    }
  ],
  "classify": [
    {
      "name": "lte at limit is normal",
      "high": 50,
      "high_op": "lte",
      "value": 50,
      "expect": "normal"
    },
    {
      "name": "lte just above is high",
      "high": 50,
      "high_op": "lte",
      "value": 50.1,
      "expect": "high"
    },
    {
      "name": "lt at limit is high",
      "high": 50,
      "high_op": "lt",
      "value": 50,
      "expect": "high"
    },
    {
      "name": "bare high behaves as lte",
      "high": 50,
      "value": 50,
      "expect": "normal"
    },
    {
      "name": "low inclusive at limit",
      "low": 15,
      "value": 15,
      "expect": "normal"
    },
    {
      "name": "below low is low",
      "low": 15,
      "value": 14.9,
      "expect": "low"
    },
    {
      "name": "gt low at limit is low",
      "low": 15,
      "low_op": "gt",
      "value": 15,
      "expect": "low"
    },
    {
      "name": "within both bounds",
      "low": 15,
      "high": 400,
      "value": 100,
      "expect": "normal"
    },
    {
      "name": "no bounds is normal",
      "value": 999,
      "expect": "normal"
    }
  ],
  "interpret": [
    {
      "name": "ALT adult male above limit",
      "ranges": "provider:mft-nhs",
      "test_id": "alanine-aminotransferase",
      "value": 62,
      "patient": {
        "sex": "male",
        "age": {
          "value": 34,
          "unit": "years"
        }
      },
      "expect": {
        "flag": "high",
        "stratum_high": 50,
        "units": "IU/L"
      }
    },
    {
      "name": "ALT adult male exactly at limit is normal",
      "ranges": "provider:mft-nhs",
      "test_id": "alanine-aminotransferase",
      "value": 50,
      "patient": {
        "sex": "male",
        "age": {
          "value": 34,
          "unit": "years"
        }
      },
      "expect": {
        "flag": "normal",
        "stratum_high": 50
      }
    },
    {
      "name": "ALT adult female uses the narrower female band",
      "ranges": "provider:mft-nhs",
      "test_id": "alanine-aminotransferase",
      "value": 40,
      "patient": {
        "sex": "female",
        "age": {
          "value": 34,
          "unit": "years"
        }
      },
      "expect": {
        "flag": "high",
        "stratum_high": 35
      }
    },
    {
      "name": "ALT neonate uses the wider all-sex band",
      "ranges": "provider:mft-nhs",
      "test_id": "alanine-aminotransferase",
      "value": 85,
      "patient": {
        "sex": "male",
        "age": {
          "value": 10,
          "unit": "days"
        }
      },
      "expect": {
        "flag": "normal",
        "stratum_high": 90
      }
    },
    {
      "name": "ALT at 28 days: inclusive upper bound keeps the neonatal band",
      "ranges": "provider:mft-nhs",
      "test_id": "alanine-aminotransferase",
      "value": 85,
      "patient": {
        "sex": "male",
        "age": {
          "value": 28,
          "unit": "days"
        }
      },
      "expect": {
        "flag": "normal",
        "stratum_high": 90
      }
    },
    {
      "name": "ALT at 29 days moves to the adult male band",
      "ranges": "provider:mft-nhs",
      "test_id": "alanine-aminotransferase",
      "value": 85,
      "patient": {
        "sex": "male",
        "age": {
          "value": 29,
          "unit": "days"
        }
      },
      "expect": {
        "flag": "high",
        "stratum_high": 50
      }
    },
    {
      "name": "ferritin young child uses lower floor",
      "ranges": "provider:mft-nhs",
      "test_id": "ferritin",
      "value": 13,
      "patient": {
        "sex": "male",
        "age": {
          "value": 3,
          "unit": "years"
        }
      },
      "expect": {
        "flag": "normal",
        "stratum_low": 12
      }
    },
    {
      "name": "ferritin adult male below floor",
      "ranges": "provider:mft-nhs",
      "test_id": "ferritin",
      "value": 13,
      "patient": {
        "sex": "male",
        "age": {
          "value": 30,
          "unit": "years"
        }
      },
      "expect": {
        "flag": "low",
        "stratum_low": 15
      }
    },
    {
      "name": "ferritin adult female ceiling differs from male",
      "ranges": "provider:mft-nhs",
      "test_id": "ferritin",
      "value": 200,
      "patient": {
        "sex": "female",
        "age": {
          "value": 30,
          "unit": "years"
        }
      },
      "expect": {
        "flag": "high",
        "stratum_high": 150
      }
    },
    {
      "name": "ALP adult all-sex band",
      "ranges": "provider:mft-nhs",
      "test_id": "alkaline-phosphatase",
      "value": 140,
      "patient": {
        "sex": "male",
        "age": {
          "value": 30,
          "unit": "years"
        }
      },
      "expect": {
        "flag": "high",
        "stratum_high": 130
      }
    },
    {
      "name": "ALP child band",
      "ranges": "provider:mft-nhs",
      "test_id": "alkaline-phosphatase",
      "value": 200,
      "patient": {
        "sex": "female",
        "age": {
          "value": 5,
          "unit": "years"
