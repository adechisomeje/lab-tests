      },
      "expect": {
        "flag": "normal",
        "stratum_low": 142,
        "stratum_high": 335
      }
    },
    {
      "name": "ALP adolescent is sex-specific",
      "ranges": "provider:mft-nhs",
      "test_id": "alkaline-phosphatase",
      "value": 300,
      "patient": {
        "sex": "female",
        "age": {
          "value": 14,
          "unit": "years"
        }
      },
      "expect": {
        "flag": "high",
        "stratum_high": 254
      }
    },
    {
      "name": "SAFETY: a band with an uninterpretable age unit must be rejected, not applied. ALP has a 'days to years' band that would otherwise swallow a 20-day-old.",
      "ranges": "provider:mft-nhs",
      "test_id": "alkaline-phosphatase",
      "value": 200,
      "patient": {
        "sex": "male",
        "age": {
          "value": 20,
          "unit": "days"
        }
      },
      "expect_error": "no_applicable_stratum"
    },
    {
      "name": "SAFETY: unknown sex must not borrow a sex-specific band",
      "ranges": "provider:mft-nhs",
      "test_id": "alanine-aminotransferase",
      "value": 45,
      "patient": {
        "sex": "",
        "age": {
          "value": 34,
          "unit": "years"
        }
      },
      "expect_error": "no_applicable_stratum"
    },
    {
      "name": "SAFETY: unknown age must not be applied to a banded interval",
      "ranges": "provider:mft-nhs",
      "test_id": "alanine-aminotransferase",
      "value": 45,
      "patient": {
        "sex": "male"
      },
      "expect_error": "no_applicable_stratum"
    },
    {
      "name": "SAFETY: interpretation refuses without an explicit range source",
      "ranges": "none",
      "test_id": "alanine-aminotransferase",
      "value": 62,
      "patient": {
        "sex": "male",
        "age": {
          "value": 34,
          "unit": "years"
        }
      },
      "expect_error": "no_range_source"
    },
    {
      "name": "unknown test id",
      "ranges": "provider:mft-nhs",
      "test_id": "no-such-test",
      "value": 1,
      "patient": {
        "sex": "male",
        "age": {
          "value": 30,
          "unit": "years"
        }
      },
      "expect_error": "unknown_test"
    },
    {
      "name": "custom ranges take effect",
      "ranges": "custom",
      "custom_ranges": {
        "ferritin": [
          {
            "sex": "all",
            "high": 10,
            "high_op": "lte"
          }
        ]
      },
      "test_id": "ferritin",
      "value": 20,
      "patient": {
        "sex": "male",
        "age": {
          "value": 30,
          "unit": "years"
        }
      },
      "expect": {
        "flag": "high",
        "stratum_high": 10
      }
    },
    {
      "name": "SAFETY: custom ranges must NOT fall back to provider data",
      "ranges": "custom",
      "custom_ranges": {
        "ferritin": [
          {
            "sex": "all",
            "high": 10
          }
        ]
      },
      "test_id": "alanine-aminotransferase",
      "value": 62,
      "patient": {
        "sex": "male",
        "age": {
          "value": 34,
          "unit": "years"
        }
      },
      "expect_error": "no_intervals"
    },
    {
      "name": "fuzzy-linked intervals must warn (serum-ferritin is linked to 'Ferritin' by name matching)",
      "ranges": "provider:mft-nhs",
      "test_id": "serum-ferritin",
      "value": 500,
      "patient": {
        "sex": "male",
        "age": {
          "value": 30,
          "unit": "years"
        }
      },
      "expect": {
        "flag": "high",
        "stratum_high": 400,
        "warns": true
      }
    }
  ],
  "draw": [
    {
      "name": "tubes ordered by the provider's documented sequence",
      "provider": "mft-nhs",
      "test_ids": [
        "ammonia",
        "lactate",
        "ferritin"
      ],
      "expect_tube_order": [
        "serum-gel",
        "fluoride-oxalate",
        "edta"
      ],
      "expect_min_warnings": 1,
      "expect_unresolved": 0
    },
    {
      "name": "tests with no published tube are reported, not dropped",
      "provider": "mft-nhs",
      "test_ids": [
        "full-blood-count-and-automated-differential",
        "ferritin"
      ],
      "expect_tube_order": [
        "serum-gel"
      ],
      "expect_unresolved": 1
    },
    {
      "name": "single tube raises no CLSI conflict warning",
      "provider": "mft-nhs",
      "test_ids": [
        "ferritin"
      ],
      "expect_tube_order": [
        "serum-gel"
      ],
      "expect_unresolved": 0
    },
    {
      "name": "unknown test id is an error",
      "provider": "mft-nhs",
      "test_ids": [
        "no-such-test"
      ],
      "expect_error": "unknown_test"
    }
  ],
  "search": [
    {
      "query": "ferritin",
      "expect_contains": "ferritin",
      "expect_first": "ferritin"
    },
    {
      "query": "FERRITIN",
      "expect_contains": "ferritin"
    },
    {
      "query": "mullerian",
      "expect_contains": "anti-mullerian-hormone-amh"
    },
    {
      "query": "Anti-Müllerian",
      "expect_contains": "anti-mullerian-hormone-amh"
    },
    {
      "query": "naive memory",
      "expect_contains": "naive-memory-and-effector-t-cell-subsets"
    },
    {
      "query": "",
      "expect_empty": true
    }
  ],
  "order_set": [
    {
      "profile": "aesthetic-beauty-clinic",
      "core_only": true,
      "expect_count": 38
    },
    {
      "profile": "aesthetic-beauty-clinic",
      "core_only": false,
      "expect_count": 50
    },
    {
      "profile": "no-such-clinic",
      "core_only": true,
      "expect_error": "unknown_profile"
    }
  ],
  "result_format": [
    {
      "name": "panel",
      "test_id": "lipid-profile-incl-total-cholesterol-ldl-hdl-triglyceride",
      "expect": {
        "kind": "panel",
        "structured_entry": true
      }
    },
    {
      "name": "narrative results must not be entered as fields",
      "test_id": "cervical-cytology",
      "expect": {
        "kind": "narrative",
        "structured_entry": false
      }
    },
    {
      "name": "referral work returns its own report",
      "test_id": "anti-c1q",
      "expect": {
        "kind": "document",
        "structured_entry": false
      }
    },
    {
      "name": "single measured quantity",
      "test_id": "alanine-aminotransferase",
      "expect": {
        "kind": "single-analyte",
        "structured_entry": true
      }
    },
    {
      "name": "culture report",
      "test_id": "abscesses-and-deep-seated-wound-infections",
      "expect": {
        "kind": "qualitative",
        "structured_entry": true
      }
    },
    {
      "name": "an Immunology antibody test now resolves to a shape rule rather than falling through as unstructured",
      "test_id": "acetyl-choline-receptor-antibodies",
      "expect": {
        "kind": "qualitative",
        "structured_entry": true
      }
    },
    {
      "name": "every test resolves to a result format",
      "coverage": {
        "all_tests_have_format": true
      }
    }
  ],
  "result_template": [
    {
      "name": "lipid profile seeds the components the EMR expects",
      "test_id": "lipid-profile-incl-total-cholesterol-ldl-hdl-triglyceride",
      "expect": {
        "template_id": "lipid-profile",
        "component_ids": [
          "total-cholesterol",
          "hdl-cholesterol",
          "ldl-cholesterol",
          "triglycerides",
          "non-hdl-cholesterol",
          "cholesterol-hdl-ratio"
        ],
        "completeness_score": 1.0,
        "components": {
          "total-cholesterol": {
            "type": "numeric",
            "entry_mode": "measured",
            "required": true,
            "suggested_units": "mmol/L"
          },
          "ldl-cholesterol": {
            "entry_mode": "either",
            "required": true,
            "has_calculation": true
          },
          "non-hdl-cholesterol": {
            "entry_mode": "calculated",
            "required": false
          },
          "cholesterol-hdl-ratio": {
            "unitless": true,
            "entry_mode": "calculated"
          }
        }
      }
    },
    {
      "name": "SAFETY: templates must never carry reference ranges or critical limits",
      "test_id": "lipid-profile-incl-total-cholesterol-ldl-hdl-triglyceride",
      "expect": {
        "no_component_keys": [
          "reference_range",
          "reference_intervals",
          "critical_low",
          "critical_high",
          "critical_limits"
        ]
      }
    },
    {
      "name": "standalone starter template with no matching catalogue test",
      "template_id": "urea-and-electrolytes",
      "expect": {
        "component_count": 7,
        "applies_to": []
      }
    },
    {
      "name": "template derived from the source's own notes is flagged low confidence",
      "test_id": "acute-leukaemia-panel",
      "expect": {
        "template_id": "acute-leukaemia-panel-derived",
        "template_source": "derived-from-source-notes"
      }
    },
    {
      "name": "unknown template id resolves to nothing",
      "template_id": "no-such-template",
      "expect_no_template": true
    },
    {
      "name": "COVERAGE: every test has a template so no result screen is blank",
      "coverage": {
        "all_tests_have_template": true
      }
    },
    {
      "name": "pattern-assigned templates declare low confidence",
      "test_id": "aptt",
      "expect": {
        "template_source": "pattern",
        "confidence": "low"
      }
    },
    {
      "name": "narrative tests get a sectioned report, not numeric fields",
      "test_id": "cervical-cytology",
      "expect": {
        "entry_style": "report",
        "component_ids": [
          "specimen-description",
          "microscopic-description",
          "diagnosis",
          "reported-by"
        ]
      }
    },
    {
      "name": "referral work gets document metadata only",
      "test_id": "anti-c1q",
      "expect": {
        "entry_style": "document",
        "template_source": "pattern"
      }
    },
    {
      "name": "SAFETY: notes-derived components must not split inside parentheses",
      "test_id": "acute-leukaemia-panel",
      "expect": {
        "component_ids": [
          "cd2",
          "cd10",
          "cd13",
          "cd14",
          "cd19",
          "cd33",
          "cd34",
          "cytocd79a",
          "cd117",
          "cytotdt",
          "cytompo"
        ]
      }
    }
  ]
}
