          "entry_mode": "measured", "required": true,
          "analyte_ref": "Albumin", "catalogue_ref": "albumin",
          "alternate_units": ["g/dL"] },
        { "id": "total-protein", "name": "Total protein", "type": "numeric",
          "entry_mode": "measured", "required": false,
