{
  "$comment": "STARTER templates for structured internal result entry. These seed a clinic's own catalogue; they are never authoritative. Units are SUGGESTIONS ONLY and vary by laboratory, analyser, population and measurement system. Reference ranges and critical limits are deliberately absent: they belong to the clinic's activated, versioned test definition, not to a global library. 'analyte_ref' links a component to a named analyte in the provider reference-range document so the build can resolve suggested units with provenance; 'catalogue_ref' links it to a test in this catalogue.",
  "version": "0.1.0",
  "notice": "Starter templates. Confirm every component, unit and entry mode against your own laboratory's method before activating. Reference ranges and critical limits are intentionally not supplied.",
  "templates": [
    {
      "id": "lipid-profile",
      "name": "Lipid Profile",
      "description": "Cardiovascular risk lipid panel.",
      "applies_to": ["lipid-profile-incl-total-cholesterol-ldl-hdl-triglyceride"],
      "components": [
        { "id": "total-cholesterol", "name": "Total cholesterol", "type": "numeric",
          "entry_mode": "measured", "required": true,
          "analyte_ref": "Total Cholesterol", "catalogue_ref": "cholesterol",
          "alternate_units": ["mg/dL"] },
        { "id": "hdl-cholesterol", "name": "HDL cholesterol", "type": "numeric",
          "entry_mode": "measured", "required": true,
          "analyte_ref": "HDL - blood", "alternate_units": ["mg/dL"] },
        { "id": "ldl-cholesterol", "name": "LDL cholesterol", "type": "numeric",
          "entry_mode": "either", "required": true,
          "analyte_ref": "LDL", "alternate_units": ["mg/dL"],
          "calculation": {
            "name": "Friedewald equation",
            "expression": "total_cholesterol - hdl_cholesterol - (triglycerides / 2.2)",
            "units_basis": "mmol/L",
            "caveats": "Not valid at high triglycerides (commonly cited limit ~4.5 mmol/L) or in non-fasting samples; many laboratories now measure LDL directly. Divisor differs in mg/dL-based systems.",
            "clinic_approval_required": true } },
        { "id": "triglycerides", "name": "Triglycerides", "type": "numeric",
          "entry_mode": "measured", "required": true,
          "analyte_ref": "Triglycerides", "catalogue_ref": "triglycerides",
          "alternate_units": ["mg/dL"] },
        { "id": "non-hdl-cholesterol", "name": "Non-HDL cholesterol", "type": "numeric",
          "entry_mode": "calculated", "required": false,
          "analyte_ref": "NON HDL Cholesterol (calculation)",
          "calculation": {
            "name": "Non-HDL cholesterol",
            "expression": "total_cholesterol - hdl_cholesterol",
            "units_basis": "mmol/L", "clinic_approval_required": true } },
        { "id": "cholesterol-hdl-ratio", "name": "Cholesterol / HDL ratio", "type": "numeric",
          "entry_mode": "calculated", "required": false, "unitless": true,
          "analyte_ref": "Total Cholesterol to HDL ratio",
          "calculation": {
            "name": "Cholesterol to HDL ratio",
            "expression": "total_cholesterol / hdl_cholesterol",
            "clinic_approval_required": true } }
      ]
    },
    {
