        { "id": "alp", "name": "Alkaline phosphatase (ALP)", "type": "numeric",
          "entry_mode": "measured", "required": true, "analyte_ref": "Alkaline Phosphatase (ALP)",
          "catalogue_ref": "alkaline-phosphatase" },
        { "id": "albumin", "name": "Albumin", "type": "numeric", "entry_mode": "measured",
          "required": true, "analyte_ref": "Albumin", "catalogue_ref": "albumin" }
      ]
    },
