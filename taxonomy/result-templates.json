          "catalogue_ref": "creatinine-blood-and-urine", "alternate_units": ["mg/dL"] },
        { "id": "egfr", "name": "Estimated GFR", "type": "numeric", "entry_mode": "calculated",
          "required": false, "analyte_ref": "Estimated Glomerular Filtration Rate CKD-EPI 2012 (EGFR)",
          "catalogue_ref": "egfr-estimated-gfr",
