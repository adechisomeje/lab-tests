        { "id": "calcium", "name": "Calcium (total)", "type": "numeric", "entry_mode": "measured",
          "required": true, "analyte_ref": "Calcium (serum/plasma)",
          "catalogue_ref": "calcium-blood-and-urine", "alternate_units": ["mg/dL"] },
        { "id": "phosphate", "name": "Phosphate", "type": "numeric", "entry_mode": "measured",
